{
  "version": 1,
  "name": "Archipelago (example)",
  "projection": "equirectangular",
  "background": "#0b1d3a",
  "bounds": [-40, -25, 50, 30],
  "layers": [
    {
      "type": "geojson",
      "name": "Guide lines",
      "style": { "stroke": "#3a5a8a", "strokeWidth": 0.5, "fill": "none" },
      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "properties": { "name": "Equator" },
            "geometry": { "type": "LineString", "coordinates": [[-60, 0], [60, 0]] }
          },
          {
            "type": "Feature",
            "properties": { "name": "Prime meridian" },
            "geometry": { "type": "LineString", "coordinates": [[0, -30], [0, 30]] }
          }
        ]
      }
    },
    {
      "type": "geojson",
      "name": "Islands",
      "style": { "stroke": "#a5d6a7", "strokeWidth": 1, "fill": "#2e7d32" },
      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "properties": { "name": "North island" },
            "geometry": {
              "type": "Polygon",
              "coordinates": [[[-20, 10], [-20, 20], [-5, 22], [-2, 12], [-12, 6], [-20, 10]]]
            }
          },
          {
            "type": "Feature",
            "properties": { "name": "South island" },
            "geometry": {
              "type": "Polygon",
              "coordinates": [[[10, -10], [8, 0], [18, 4], [24, -6], [16, -14], [10, -10]]]
            }
          },
          {
            "type": "Feature",
            "properties": { "name": "East islet" },
            "geometry": {
              "type": "Polygon",
              "coordinates": [[[30, 15], [31, 20], [38, 21], [39, 14], [30, 15]]]
            }
          }
        ]
      }
    }
  ]
}
